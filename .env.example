# Site
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5561996796542

# Sanity (CMS). The site renders with fallback content when these are empty.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01
# Server-only token with Editor role, used by the weekly draft automation.
SANITY_API_WRITE_TOKEN=

# OpenRouter (weekly article drafts). Optional: without a key the job is skipped.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_FALLBACK_MODEL=openai/gpt-5

# Protects /api/cron/weekly-article. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
